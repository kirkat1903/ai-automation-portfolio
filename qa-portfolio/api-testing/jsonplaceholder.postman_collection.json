{
  "info": {
    "name": "QA Portfolio — JSONPlaceholder",
    "description": "Positive, negative, schema and performance checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "https://jsonplaceholder.typicode.com"}],
  "item": [
    {
      "name": "GET posts — list",
      "request": {"method": "GET", "url": "{{baseUrl}}/posts"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
        "pm.test('Array is not empty', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);",
        "pm.test('Under 1500 ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));"
      ]}}]
    },
    {
      "name": "GET post 1",
      "request": {"method": "GET", "url": "{{baseUrl}}/posts/1"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Expected fields', () => { const b=pm.response.json(); ['userId','id','title','body'].forEach(k=>pm.expect(b).to.have.property(k)); });",
        "pm.test('Correct id', () => pm.expect(pm.response.json().id).to.eql(1));"
      ]}}]
    },
    {
      "name": "GET posts by user",
      "request": {"method": "GET", "url": "{{baseUrl}}/posts?userId=1"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Only user 1', () => pm.response.json().forEach(x=>pm.expect(x.userId).to.eql(1)));"
      ]}}]
    },
    {
      "name": "POST post",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"QA portfolio\",\n  \"body\": \"API test\",\n  \"userId\": 1\n}"}, "url": "{{baseUrl}}/posts"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "pm.test('Created object returned', () => { const b=pm.response.json(); pm.expect(b).to.include({title:'QA portfolio',body:'API test',userId:1}); pm.expect(b).to.have.property('id'); });"
      ]}}]
    },
    {
      "name": "GET missing post",
      "request": {"method": "GET", "url": "{{baseUrl}}/posts/999999"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));",
        "pm.test('Valid JSON object', () => pm.expect(pm.response.json()).to.be.an('object'));"
      ]}}]
    }
  ]
}

